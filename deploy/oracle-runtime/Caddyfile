www.lumesocial.online {
    redir https://lumesocial.online{uri} permanent
}

lumesocial.online, 163-176-48-153.sslip.io {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        -Server
    }

    @appFrames not path /site/assets/profile/index.html
    header @appFrames X-Frame-Options "DENY"
    @profileDemo path /site/assets/profile/index.html
    header @profileDemo {
        >X-Frame-Options "SAMEORIGIN"
        >Content-Security-Policy "frame-ancestors 'self'"
    }

    request_body {
        max_size 50MB
    }

    handle_path /livekit/* {
        reverse_proxy host.docker.internal:7880
    }

    handle_path /source/* {
        root * /srv/source
        file_server
    }

    handle_path /downloads/* {
        root * /srv/downloads
        header Content-Disposition "attachment"
        file_server
    }

    handle {
        reverse_proxy lume:3000
    }
}
